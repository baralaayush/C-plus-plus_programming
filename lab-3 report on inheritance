		cout<<"Roll No: "<<roll<<endl;
		cout<<"Total Marks: "<<total<<endl;
		cout<<"Percentage: "<<percent<<"%";
	}
}; 
int main()
{
	result obj;
	obj.compute();
	obj.display();
	return 0;
}

