#include<iostream>
using namespace std;
#define Pie 3.14
class rectangle{
	float l,b,peri,ar;
	public:
	void getdata()
	{
		cout<<"Enter length of rectangle:";
		cin>>l;
		cout<<"Enter breadth of rectangle:";
		cin>>b;
	}
	void display()
	{	
		peri=2*(l+b);
		ar=l*b;
		cout<<"The perimeter and area of rectangle is:";
		cout<<peri<<","<<ar<<endl;
	}
}r;

class circle
{
float r;
float ar,cr;
public:
	void getdata()
	{
		cout<<"Enter radius of circle:";
		cin>>r;
	}
	void display()
	{	
		cr=2*Pie*r;
		ar=Pie*r*r;
		cout<<"The area and circumference of circle is:";
		cout<<ar<<","<<cr<<endl;
	}
}c;
