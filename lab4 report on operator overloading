/*1. Write a program to overload the unary minus (--) operator for a class Number having one data member, so that -n1 changes the sign of the value*/

#include<iostream>
using namespace std;
class number{
	int a;
	public:
		number()
		{
		a=10;
		}
		void operator --()
		{
			a=-a; 
		}
		void display(){
			cout<<a<<endl;
		}
};
int main()
{
	number n1;
	cout<<"The value of a before operator overloading is:"<<endl;
	n1.display();
	--n1;
	cout<<"The value of a after operator overloading is:";
	n1.display();
	return 0;
}


