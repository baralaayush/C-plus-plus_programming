/*D1. Create a class Sample with two private integers a and b, and a public function to set their values. Write a friend function average() that takes a Sample object and returns the average of a and b. Call it from main().*/

#include<iostream>
using namespace std;
class sample{
	int a,b;
	public:
		sample(){
			a=0;
			b=0;
		}
		sample(int x,int y){
			a=x;
			b=y;
		}
		friend void average(sample s);
};
void average(sample s){
	cout<<"The average is:"<<float(s.a+s.b)/2;
}
int main(){
	sample s(10,15);
	average(s);
	return 0;
}



