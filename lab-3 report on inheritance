/*Create a base class A and derived class B, each with a parameterized constructor. Show how the
derived class constructor passes values to the base class constructor using an initializer list.
*/
#include<iostream>
using namespace std;
class A{
	protected:
		int a,b,c,d;
	public:
		A(int x,int y)
		{
			a=x;
			b=y;
		}
};

class B:public A{
	public:
		B(int x,int y):A(2,3)
		{
			c=x;
			d=y;
		}
		void display(){
			cout<<"value of a,b from base class constructor: "<<a<<","<<b<<endl;
			cout<<"Value of c,d from child class constructor: "<<c<<","<<d;
		}
};
int main()
{
	B obj(4,5);
	obj.display();
	return 0;
}

