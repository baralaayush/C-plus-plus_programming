/*15. Create a class Engine with attributes like horsepower. Create a class Car that contains an object
of Engine as a member (has-a relationship), along with its own attributes like model. Write
getdata() and display() functions in Car that also call the corresponding functions of the Engine
object.
*/
#include<iostream>
using namespace std;
class engine{
	protected:
		int data;
	public:
		void info(){
			cout<<"Enter Horsepower: ";
			cin>>data;
		}
		void show(){
			cout<<data;
		}
};
class car{
	int model;
	engine obj;
	public:
		void getdata()
		{
		obj.info();
		cout<<"Enter Model: ";
		cin>>model;	
		}
		void display(){
			cout<<"The car details are:"<<endl;
			cout<<"Horsepower=";
			obj.show();
			cout<<endl;
			cout<<"Model="<<model;
		}
};
int main()
{
	car obj1;
	obj1.getdata();
	obj1.display();
	return 0;
}
