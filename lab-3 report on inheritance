/*(Hierarchical Inheritance) Create a base class Shape with a method getData(). Derive Circle and
Rectangle classes from it, each computing their own area.*/
#include<iostream>
#define pie 3.1415
using namespace std;
class shape{
	protected:
	float r;
	float l,b;
	float ar1,ar2;
		
		void getdata1()
		{
			cout<<"Enter radius of circle:";
			cin>>r;
		}
		void getdata2()
		{
			cout<<"Enter length and breadth of rectangle:";
			cin>>l>>b;
		}
};

class circle:public shape{
	public:
		void compute()
		{
			getdata1();
			ar1=pie*r*r;
			showdata();
		}
		void showdata()
		{
			cout<<"The area of circle="<<ar1<<endl;
		}
};

class rectangle:public shape{
	public:
		void compute()
		{
			getdata2();
			ar2=l*b;
			showdata();
		}
		void showdata()
		{
			cout<<"The area of rectangle="<<ar2;
		}	
};
int main()
{
	circle obj1;
	obj1.compute();
	rectangle obj2;
	obj2.compute();
	return 0;
}
