/*(Multiple Inheritance) Create two classes Theory and Practical, each storing marks out of 100.
Derive a class Result from both, which computes and displays total and percentage.*/
#include<iostream>
using namespace std;
class theory{
	protected:
	static int mark1;
};

class practical{
	protected:
	static int mark2;
};

int theory::mark1=70;
int practical::mark2=52;

class result:public theory,public practical{
	float total,percent;
	public:
		void calc()
		{
		total=mark1+mark2;
		percent=(total/200)*100;	
		}
		
		void display()
		{
			cout<<"Total Mark="<<total<<endl;
			cout<<"Percent="<<percent<<"%";
		}
};
int main()
{
	result obj;
	obj.calc();
	obj.display();
	return 0;
}
