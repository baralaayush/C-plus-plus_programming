			cout<<"t1 is greater ie: ";
			t1.display();
			}
			else
			{
				cout<<"t2 is greater ie: ";
				t2.display();
			}
			break;
			
			case 2:
				if(t1==t2){
				cout<<"both t1 and t2 are equal ie: ";
				t1.display();
				}
				else
				cout<<"Not equal";
				break;
				
				case 3:
					if(t1!=t2){
					cout<<"t1 and t2 are not equal ie:\n";
					t1.display();
					t2.display();
					}
					else{
					cout<<"both t1 and t2 are equal ie: ";
					t1.display();
					}
					break;
					
					default:
						cout<<"Invalid operation choosed";
	}
	return 0;
