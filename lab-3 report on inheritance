/*(Multilevel Inheritance) Create a class Student (roll, name) ? derive Marks(three subject marks)
? derive Result (computes total and percentage). Test with a main() function.
*/
#include<iostream>
#include<string>
using namespace std;
class student{
	protected:
		int roll;
		string name;		
};

class marks:protected student{
	protected:
		float m1,m2,m3;
		public:
			void getdata()
			{	
				cout<<"Enter student name:";
				getline(cin,name);
				cout<<"Enter roll no:";
