/*F4. Create a class Counter with a private integer count, initialized to 0 in the constructor. Write a member function increment() that increases count by 1 and ends with return *this; (the function's return type should be Counter&). In main(), call it in a chained manner, like:
Counter c; c.increment().increment().increment(); Print the final value of count and explain in one line how return *this; makes this chaining possible.*/

#include<iostream>
using namespace std;
class counter{
	int count;
	public:
	counter(){
		count=0;
	}
	counter &increment(){
		++count;
		return *this;
	}
	void display(){
		cout<<"Count value="<<count;
	}
};
int main()
{
	counter c;
	c.increment().increment().increment();
	c.display();
	return 0;
}
