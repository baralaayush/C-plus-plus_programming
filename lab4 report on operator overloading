	int hrs;
	int min;
	public:
		time(){
			hrs=0;
			min=0;
		}
		void getdata(){
			cout<<"Enter hrs and min:";
			cin>>hrs>>min;
		}
		int operator >(time t){
			if(hrs>t.hrs)
			return 1;
			else if(hrs==t.hrs && min>t.min)
			return 1;
			else 
			return 0;
		}
		int operator ==(time t){
			if(hrs==t.hrs && min==t.min)
			return 1;
			else 
			return 0;
		}
		int operator !=(time t){
			if(hrs!=t.hrs)
			return 1;
			else if(hrs==t.hrs && min!=t.min)
			return 1;
			else 
			return 0;
		}
		void display(){
			cout<<"Hrs and Min="<<hrs<<":"<<min<<endl;
		}
};
