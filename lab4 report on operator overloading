/*16. Design a class Fraction with numerator and denominator. Overload % and / so that f3
= f1 % f2 and f3 = f1 / f2 work meaningfully on fraction objects.*/

#include<iostream>
using namespace std;
class fraction {
	float num;
	float den;
	public:
		void getdata(){
			cout<<"Enter Numerator and Denominator:";
			cin>>num>>den;
		}
		
		void display(){
			cout << num << "/" << den << " (Decimal: " << (float)num / den << ")" << endl;
		}
		fraction operator %(fraction f){
			fraction temp;
			int quotient = (num * f.den) / (den * f.num);
        	
			// Remainder = (num/den) - quotient * (f.num/f.den)
        	temp.num = (num * f.den) - (quotient * f.num * den);
        	temp.den = den * f.den;
        	return temp;
		}
		fraction operator /(fraction f){
			fraction temp;
			temp.num=num*f.den;
			temp.den=den*f.num;
			return temp;
		}
};
int main()
{
	fraction f1,f2,f3;
	cout<<"Enter for object f1:\n";
	f1.getdata();
	cout<<"Enter for object f2:\n";
	f2.getdata();
	f3=f1%f2;
	cout<<"After operation f3=f1%f2:"<<endl;
	f3.display();
	f3=f1/f2;
	cout<<"\nAfter operation f3=f1/f2:"<<endl;
	f3.display();
	return 0;
}


/*17. Design a class Time with data members hour and minute. Overload the Time class for >, ==, and !=. Write a menu-driven program that lets the user enter two times and choose which comparison to perform.*/

