/*E1. Create a class Complex with two private data members real and imag. Write a public function setValue(int r, int i) and a function display() to print the number in the form real + imag i. Overload the+ operator using a friend function:friend Complex operator+(Complex c1, Complex c2);*/

#include<iostream>
using namespace std;
class complex{
	int real;
	int img;
	public:
		complex(){
			real=0;
			img=0;
		}
		void setvalue(int r, int i){
			real=r;
			img=i;
		}
		void display(){
			cout<<"The complex number is:"<<real<<"+"<<img<<"i";
		}
		friend complex operator +(complex c1,complex c2);
};
complex operator +(complex c1,complex c2){
	complex temp;
	temp.real=c1.real+c2.real;
	temp.img=c1.img+c2.img;
	return temp;
}
int main(){
	complex t,t1,t2;
	t.setvalue(12,10);
	t1.setvalue(8,10);
	t2=t+t1;
	t2.display();
	return 0;
}



/*E2. Create a class Distance with data members feet and inches. Using a friend function, overload the +operator to add two Distance objects (remember: 12 inches = 1 foot, so handle the carry-over). Display the result using a display() function.*/

#include<iostream>
using namespace std;
class Distance{
	int feet;
	int inches;
	public:
		Distance(){
			feet=0;
			inches=0;
		}
		void setvalue(int r, int i){
			feet=r;
			inches=i;
		}
		void display(){
			cout<<"The total distance is:"<<endl;
			cout<<"Feet="<<feet<<endl;
			cout<<"Inches="<<inches;
		}
		friend Distance operator +(Distance d1,Distance d2);
};
Distance operator +(Distance d1,Distance d2){
	Distance temp;
	temp.inches=d1.inches+d2.inches;
	temp.feet=d1.feet+d2.feet+temp.inches/12;
	temp.inches=temp.inches%12;
	return temp;
}
int main(){
	Distance t,t1,t2;
	t.setvalue(12,10);
	t1.setvalue(8,10);
	t2=t+t1;
	t2.display();
	return 0;
}



