/*(Hybrid Inheritance) Create classes Person ? Student and Person ? Exam, then derive
Result class from both Student and Exam. Display all details in one output.
*/
#include<iostream>
#include<string>
using namespace std;
class person{
	protected:
		string name;
		public:
		void getdata1(){
			cout<<"Enter your name:";
			getline(cin,name);
		}
};

class student:public person{
	protected:
	int roll;
	string level;
	public:
	void getdata2(){
		cout<<"Enter your roll no:";
		cin>>roll;
		cin.ignore();
		cout<<"Enter your class level:";
		getline(cin,level);
	}
};

class exam{
	protected:
	float mark;
	float percent;
	public:
		void getdata3()
		{
			cout<<"Enter your total marks of 5 subject:";
			cin>>mark;
		}
		void calc()
		{
			percent=(mark/500)*100;
		}
};

class result:public student,public exam{
	public:
		void display()
		{
			cout<<"Person name: "<<name<<endl;
			cout<<"Roll no: "<<roll<<endl;
			cout<<"Class level: "<<level<<endl;
			cout<<"Total mark: "<<mark<<endl;
			cout<<"Percentage: "<<percent<<"%";
		}
};
int main()
{
	result obj;
	obj.getdata1();
	obj.getdata2();
	obj.getdata3();
	obj.calc();
	obj.display();
    return 0;
}

