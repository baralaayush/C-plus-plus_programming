/* Create a base class Vehicle with private data members speed and fuelAmount, and public member
functions to input and display them. Derive a class Car publicly from Vehicle that adds a brand
attribute. Write a main() function to test it.*/

#include<iostream>
using namespace std;
class vehicle{
	float speed;
	float fuelamount;
	public:
		void getdata(){
			cout<<"Enter speed (km/hr): ";
			cin>>speed;
			cout<<"Enter fuelAmount (L): ";
			cin>>fuelamount;
		}
		
		void showdata()
		{
			cout<<"The speed is: "<<speed<<endl;
			cout<<"The fuel Amount is: "<<fuelamount<<endl;
		}
};
class car:public vehicle
{
	public:
	void brand()
	{
		cout<<"The brand is toyota";
	}
	
};
int main()
{
	car t;
	t.getdata();
	t.showdata();
	t.brand();
	return 0;
}

