#include<iostream>
using namespace std;
class complex{
	int real;
	int img;
	public:
	complex()
	{
		real=1;
		img=1;	
	}
	complex(int x,int y)
	{
		real=x;
		img=y;
	}
	complex addcomplex(complex t1,complex t2)
	{
		complex temp;
		temp.real=real+t1.real+t2.real;
		temp.img=real+t1.img+t2.img;
		return temp;	
	}
	void show()
	{
		cout<<"The complex number is="<<real<<"+"<<img<<"i";
		}	
};
