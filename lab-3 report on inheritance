4.Lab 4: Ambiguity in Inheritance........................................................
/*Create two base classes A and B, each with a function display() having the same signature. Derive
a class C from both. Show:
• The compiler error when calling obj.display() directly.
• Two ways to resolve the ambiguity (scope resolution operator, and overriding in the derived
class).
*/
#include<iostream>
using namespace std;
class A{
	public:
	void display()
	{
		cout<<"Base class A display function"<<endl;
	}
};

class B{
	public:
		public:
	void display()
	{
		cout<<"Base class B display function"<<endl;
	}
};

class C:public B,public A{
	public:
	void display()
	{
		cout<<"Derived class C display function"<<endl; //overrides base class function display
	}
};
int main()
{
	C obj;
	obj.display();
	obj.A::display();
	obj.B::display();
	return 0;
}

